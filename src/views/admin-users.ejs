<%- include('partials/header') %>
<h1>Users</h1>
<p class="muted">Registration mode: <code><%= mode %></code> (set with the <code>REGISTRATION_MODE</code> environment variable: open, invite or closed).</p>
<% if (flash) { %><div class="flash ok"><%= flash %></div><% } %>
<table class="table">
  <thead><tr><th>User</th><th>Role</th><th>Projects</th><th>Mastered</th><th>Joined</th><th>Last login</th><th></th></tr></thead>
  <tbody>
    <% users.forEach((u) => { %>
      <tr>
        <td><%= u.username %><%= u.id === user.id ? ' (you)' : '' %></td>
        <td>
          <form method="post" action="/admin/users/<%= u.id %>/role" class="inline">
            <select name="role" onchange="this.form.submit()">
              <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>user</option>
              <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>admin</option>
            </select>
          </form>
        </td>
        <td><%= u.projects %></td>
        <td><%= u.mastered %></td>
        <td class="muted"><%= u.created_at %></td>
        <td class="muted"><%= u.last_login_at || 'never' %></td>
        <td>
          <% if (u.id !== user.id) { %>
            <form method="post" action="/admin/users/<%= u.id %>/delete" class="inline" onsubmit="return confirm('Delete <%= u.username %> and all their projects and progress?')">
              <button class="button tiny subtle" type="submit">Delete</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
<%- include('partials/footer') %>
