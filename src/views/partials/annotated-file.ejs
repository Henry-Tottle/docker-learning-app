<%#
  Renders one annotated file as clickable lines.
  Expects: file { name, lines }, viewed (Set), mode ('guided' | 'self'), concepts (map)
%>
<section class="file" data-file="<%= file.name %>">
  <h3 class="file-name"><code><%= file.name %></code></h3>
  <div class="code">
    <% file.lines.forEach((l) => { %>
      <% if (!l.explain) { %>
        <div class="code-line plain"><pre><%= l.text %></pre></div>
      <% } else { %>
        <details class="code-line explain <%= viewed.has(l.id) ? 'viewed' : '' %>" data-line-id="<%= l.id %>" data-concept="<%= l.concept || '' %>">
          <summary>
            <pre><%= l.text %></pre>
            <span class="marker" aria-hidden="true"></span>
          </summary>
          <div class="why">
            <p><%= l.explain %></p>
            <% if (l.links && l.links.length) { %>
              <ul class="links"><% l.links.forEach((k) => { %><li><a href="<%= k.href %>" target="_blank" rel="noopener"><%= k.label %></a></li><% }) %></ul>
            <% } %>
            <% if (l.concept && concepts[l.concept]) { %>
              <p class="concept-tag">Concept: <a href="/concepts/<%= l.concept %>?back=<%= encodeURIComponent(path) %>"><%= concepts[l.concept].title %></a>
                <span class="concept-status" data-concept-status="<%= l.concept %>"></span></p>
            <% } %>
          </div>
        </details>
      <% } %>
    <% }) %>
  </div>
</section>
