# Copy to .env to override defaults when running with `npm start` / `npm run dev`.
# (Node loads it via --env-file-if-exists; nothing else reads this file.)
# When running in Docker, set these as container environment variables instead.

# Port to listen on. Hosting platforms such as Railway inject their own PORT.
PORT=3000

# Where the SQLite file lives. In the Docker image this is /data/progress.db.
DB_PATH=./data/progress.db

# Who may create an account:
#   open    anyone (default; fine on your own machine)
#   invite  anyone who knows INVITE_CODE (recommended on a public URL)
#   closed  nobody, except the very first account so the server can be bootstrapped
REGISTRATION_MODE=open
INVITE_CODE=

# Set to 1 when running behind a TLS-terminating proxy (Railway, Fly, Render, nginx...).
# It makes the app trust X-Forwarded-Proto so session cookies get the Secure flag on https.
TRUST_PROXY=
